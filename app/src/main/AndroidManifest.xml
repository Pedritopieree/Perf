<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.build.gcunlock">

    <uses-permission android:name="android.permission.DUMP" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name=".ModuleApplication"
        android:label="GCUnlock"
        android:allowBackup="false"
        android:directBootAware="true"
        android:extractNativeLibs="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="com.build.gcunlock"
            android:exported="true"
            android:grantUriPermissions="true" />

        <provider
            android:name=".core.ConfigProvider"
            android:authorities="com.build.gcunlock.config"
            android:exported="false" />

    </application>
</manifest>
